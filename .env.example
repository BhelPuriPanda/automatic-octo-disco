# PostgreSQL Connection String
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/supplychainiq

# Raw Data Path (can be custom CSV or generated sample)
RAW_DATA_PATH=sample_data/raw_retail_sales.csv

# Random Seed for reproducibility
RANDOM_SEED=42
